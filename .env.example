# Devcontainer / local dev env. Copy to .env.
#
# The app needs one external thing: a PlantUML server. No token, no account —
# the server is unauthenticated by design, so the only question is where it is.

# --- Nextcloud ---
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=admin

# --- PlantUML ---
# Base URL of the PlantUML server (no trailing slash). In-cluster example:
# http://plantuml.flow.svc
PLANTUML_URL=http://localhost:8081
