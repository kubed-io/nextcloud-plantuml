  "keyword:object": {
    "summary": "Declares an object",
    "example": "object Order",
    "home": "object"
  },
  "keyword:as@gantt": {
    "summary": "Gives a task a short name",
    "example": "[Build] as [B] lasts 3 days\n[Test] starts at [B]'s end\n[Test] lasts 2 days"
  },
  "keyword:at@gantt": {
    "summary": "Places a task relative to another",
    "example": "[Build] lasts 3 days\n[Test] starts at [Build]'s end\n[Test] lasts 2 days"
  },
  "keyword:start@gantt": {
    "summary": "When a task or the project starts",
    "example": "Project starts 2026-10-05\n[Build] starts 2026-10-06\n[Build] lasts 3 days"
  },
  "keyword:end@gantt": {
    "summary": "When a task ends",
    "example": "Project starts 2026-10-05\n[Build] starts 2026-10-06\n[Build] ends 2026-10-09"
  },
  "keyword:then@gantt": {
    "summary": "Starts a task after the previous one",
    "example": "[Build] lasts 3 days\nthen [Test] lasts 2 days"
  },
  "keyword:color@gantt": {
    "summary": "Colours a link between tasks",
    "example": "[Build] lasts 3 days\n[Test] starts at [Build]'s end with blue dotted link\n[Test] lasts 2 days"
  },
  "keyword:link@gantt": {
    "summary": "Draws the link between tasks",
    "example": "[Build] lasts 3 days\n[Test] starts at [Build]'s end with blue dotted link\n[Test] lasts 2 days"
  },
  "keyword:style@gantt": {
    "summary": "Style of a link between tasks",
    "example": "[Build] lasts 3 days\n[Test] starts at [Build]'s end with blue dotted link\n[Test] lasts 2 days"
  },
  "keyword:is@gantt": {
    "summary": "Colours or sets a task",
    "example": "[Build] lasts 3 days\n[Build] is colored in Lavender/LightBlue"
  },
  "keyword:on@gantt": {
    "summary": "Assigns resources to a task",
    "example": "[Build] on {Ann} lasts 3 days"
  },
  "keyword:label@gantt": {
    "summary": "Where task labels sit",
    "example": "[Build] lasts 3 days\nLabel on first column and Left aligned"
  },
  "keyword:footbox@gantt": {
    "summary": "The footer showing the time scale",
    "example": "[Build] lasts 3 days\nhide footbox"
  },
  "keyword:hide@gantt": {
    "summary": "Hides the footer or resources",
    "example": "[Build] lasts 3 days\nhide footbox"
  },
  "keyword:as@wbs": {
    "summary": "Names a box so arrows can reach it",
    "example": "* root\n**(A) a\n**(B) b\nA -> B"
  },
  "keyword:left@mindmap": {
    "summary": "Draws the branches after it on the left",
    "example": "* root\n** a\nleft side\n** b"
  },
  "keyword:right@mindmap": {
    "summary": "Draws the branches after it on the right",
    "example": "* root\n** a\nright side\n** b"
  },
  "keyword:top@mindmap": {
    "summary": "Lays the map out top to bottom",
    "example": "top to bottom direction\n* root\n** a"
  },
  "keyword:bottom@mindmap": {
    "summary": "Lays the map out bottom to top",
    "example": "bottom to top direction\n* root\n** a"
  },
  "keyword:left to right direction@mindmap": {
    "summary": "Lays the map out left to right",
    "example": "left to right direction\n* root\n** a"
  },
  "keyword:top to bottom direction@mindmap": {
    "summary": "Lays the map out top to bottom",
    "example": "top to bottom direction\n* root\n** a"
  },
  "keyword:h-axis@chart": {
    "summary": "Horizontal axis with its labels",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"Sales\" [3, 5]"
  },
  "keyword:v-axis@chart": {
    "summary": "Vertical axis with its range",
    "example": "h-axis \"Q\" [Q1, Q2]\nv-axis \"Sales\" 0 --> 10\nbar \"Sales\" [3, 5]"
  },
  "keyword:v2-axis@chart": {
    "summary": "Second vertical axis",
    "example": "h-axis \"Q\" [Q1, Q2]\nv2-axis \"Rate\" 0 --> 100\nline \"Rate\" [20, 40]"
  },
  "keyword:bar@chart": {
    "summary": "Series drawn as bars",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"Sales\" [3, 5]"
  },
  "keyword:line@chart": {
    "summary": "Series drawn as a line",
    "example": "h-axis \"Q\" [Q1, Q2]\nline \"Sales\" [3, 5]"
  },
  "keyword:area@chart": {
    "summary": "Series drawn as a filled area",
    "example": "h-axis \"Q\" [Q1, Q2]\narea \"Sales\" [3, 5]"
  },
  "keyword:scatter@chart": {
    "summary": "Series drawn as points",
    "example": "h-axis \"x\" 0 --> 10\nscatter \"P\" [(1,12),(6,34)]"
  },
  "keyword:circle@chart": {
    "summary": "Marker drawn as a circle",
    "example": "h-axis \"x\" 0 --> 10\nscatter \"P\" [(1,12),(6,34)] <<circle>>"
  },
  "keyword:grid@chart": {
    "summary": "Draws grid lines on an axis",
    "example": "h-axis \"Q\" [Q1, Q2] grid\nbar \"Sales\" [3, 5]"
  },
  "keyword:label@chart": {
    "summary": "Axis label placement, as label-right",
    "example": "h-axis \"Q\" [Q1, Q2] label-right\nbar \"Sales\" [3, 5]"
  },
  "keyword:left@chart": {
    "summary": "Puts an axis or legend on the left",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"Sales\" [3, 5]\nlegend left"
  },
  "keyword:right@chart": {
    "summary": "Puts an axis or legend on the right",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"Sales\" [3, 5]\nlegend right"
  },
  "keyword:top@chart": {
    "summary": "Puts an axis or legend at the top",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"Sales\" [3, 5]\nlegend top"
  },
  "keyword:bottom@chart": {
    "summary": "Puts an axis or legend at the bottom",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"Sales\" [3, 5]\nlegend bottom"
  },
  "keyword:annotation@chart": {
    "summary": "Marks a point with a note",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"Sales\" [3, 5]\nannotation \"Peak\" at (Q2, 5)"
  },
  "keyword:at@chart": {
    "summary": "Where an annotation points",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"Sales\" [3, 5]\nannotation \"Peak\" at (Q2, 5)"
  },
  "keyword:ticks@chart": {
    "summary": "Named marks along an axis",
    "example": "h-axis \"Q\" [Q1, Q2]\nv-axis \"Sales\" 0 --> 10 ticks [0:\"Low\", 10:\"High\"]\nbar \"Sales\" [3, 5]"
  },
  "keyword:spacing@chart": {
    "summary": "Gap between the entries of an axis",
    "example": "h-axis \"Q\" [Q1, Q2] spacing 20\nbar \"Sales\" [3, 5]"
  },
  "keyword:stackmode@chart": {
    "summary": "How series share the bars",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"A\" [3, 5]\nbar \"B\" [1, 2]\nstackMode stacked"
  },
  "keyword:orientation@chart": {
    "summary": "Draws the chart horizontal or vertical",
    "example": "h-axis \"Q\" [Q1, Q2]\nbar \"Sales\" [3, 5]\norientation horizontal"
  },
  "keyword:note@files": {
    "summary": "Annotates a file or folder",
    "example": "/src/main.js\nnote: entry point"
  },
  "keyword:sprite@nwdiag": {
    "summary": "Sets the icon of a node",
    "example": "network n {\n  a [sprite = \"archimate/application\"];\n}"
  },
  "keyword:nwdiag@nwdiag": {
    "summary": "Block of networks",
    "example": "network n {\n  a;\n}"
  },
  "keyword:address@nwdiag": {
    "summary": "IP address of a node",
    "example": "network n {\n  a [address = \"10.0.0.1\"];\n}"
  },
  "keyword:shape@nwdiag": {
    "summary": "Shape of a node",
    "example": "network n {\n  a [shape = database];\n}"
  },
  "keyword:highlight@json": {
    "summary": "Highlights a key in the tree",
    "example": "{ \"a\": 1, \"b\": 2 }\n#highlight \"a\""
  },
  "keyword:highlight@yaml": {
    "summary": "Highlights a key in the tree",
    "example": "a: 1\nb: 2\n#highlight \"a\""
  },
  "keyword:null@json": {
    "summary": "The JSON null value",
    "example": "{ \"a\": null }"
  },
