{
  "keyword:activate": {
    "summary": "Starts a lifeline’s activation bar",
    "example": "Alice -> Bob : hi\nactivate Bob\nBob --> Alice : ok\ndeactivate Bob",
    "home": "sequence"
  },
  "keyword:deactivate": {
    "summary": "Ends a lifeline’s activation bar",
    "example": "Alice -> Bob : hi\nactivate Bob\nBob --> Alice : ok\ndeactivate Bob",
    "home": "sequence"
  },
  "keyword:destroy": {
    "summary": "Ends a lifeline with a cross",
    "example": "Alice -> Bob : bye\ndestroy Bob",
    "home": "sequence"
  },
  "keyword:create": {
    "summary": "Draws a participant at its first message",
    "example": "create Bob\nAlice -> Bob : new",
    "home": "sequence"
  },
  "keyword:return": {
    "summary": "Answers the message that activated it",
    "example": "Alice -> Bob : ask\nactivate Bob\nreturn answer",
    "home": "sequence"
  },
  "keyword:alt": {
    "summary": "Alternatives, one drawn per else",
    "example": "alt paid\n  Shop -> Customer : receipt\nelse declined\n  Shop -> Customer : retry\nend",
    "home": "sequence"
  },
  "keyword:opt": {
    "summary": "Block drawn only when its condition holds",
    "example": "opt cached\n  Alice -> Bob : hit\nend",
    "home": "sequence"
  },
  "keyword:else": {
    "summary": "Next branch of an alt, par or if",
    "example": "alt paid\n  Shop -> Customer : receipt\nelse declined\n  Shop -> Customer : retry\nend",
    "home": "sequence"
  },
  "keyword:loop": {
    "summary": "Block repeated while its condition holds",
    "example": "loop 3 times\n  Alice -> Bob : ping\nend",
    "home": "sequence"
  },
  "keyword:par": {
    "summary": "Blocks drawn as happening in parallel",
    "example": "par\n  Alice -> Bob : a\nelse\n  Alice -> Carol : b\nend",
    "home": "sequence"
  },
  "keyword:break": {
    "summary": "Block that leaves the enclosing loop",
    "example": "loop 3 times\n  Alice -> Bob : try\n  break failed\n    Bob -> Alice : stop\n  end\nend",
    "home": "sequence"
  },
  "keyword:critical": {
    "summary": "Block that must not be interrupted",
    "example": "critical lock\n  Alice -> Bob : write\nend",
    "home": "sequence"
  },
  "keyword:group": {
    "summary": "Frame with a label of your own",
    "example": "group retry\n  Alice -> Bob : again\nend",
    "home": "sequence"
  },
  "keyword:end": {
    "summary": "Closes a group, alt, loop or other block",
    "example": "opt cached\n  Alice -> Bob : hit\nend",
    "home": "sequence"
  },
  "keyword:ref": {
    "summary": "Box that refers to another diagram",
    "example": "ref over Alice, Bob : login",
    "home": "sequence"
  },
  "keyword:box": {
    "summary": "Frames participants under a title",
    "example": "box \"Internal\" #LightBlue\n  participant Bob\n  participant Carol\nend box\nAlice -> Bob : hi",
    "home": "sequence"
  },
  "keyword:order": {
    "summary": "Sets a participant’s position",
    "example": "participant Bob order 20\nparticipant Alice order 10",
    "home": "sequence"
  },
  "keyword:as": {
    "summary": "Gives an element a short alias",
    "example": "participant \"Long name\" as L\nAlice -> L : hi",
    "home": "any"
  },
  "keyword:autonumber": {
    "summary": "Numbers the messages",
    "example": "autonumber\nAlice -> Bob : first\nBob -> Alice : second",
    "home": "sequence"
  },
  "keyword:footbox": {
    "summary": "The participant boxes at the foot",
    "example": "hide footbox\nAlice -> Bob : hi",
    "home": "sequence"
  },
  "keyword:participant": {
    "summary": "Declares a participant",
    "example": "participant Bob\nAlice -> Bob : hi",
    "home": "sequence"
  },
  "keyword:boundary": {
    "summary": "Declares a boundary participant",
    "example": "boundary Gate\nAlice -> Gate : hi",
    "home": "sequence"
  },
  "keyword:control": {
    "summary": "Declares a control participant",
    "example": "control Logic\nAlice -> Logic : hi",
    "home": "sequence"
  },
  "keyword:entity": {
    "summary": "Declares an entity participant",
    "example": "entity Order\nAlice -> Order : hi",
    "home": "sequence"
  },
  "keyword:collections": {
    "summary": "Declares a collection participant",
    "example": "collections Items\nAlice -> Items : hi",
    "home": "sequence"
  },
  "keyword:note": {
    "summary": "Attaches a note to an element",
    "example": "Alice -> Bob : hi\nnote right : seen",
    "home": "any"
  },
  "keyword:hnote": {
    "summary": "Note drawn as a hexagon",
    "example": "Alice -> Bob : hi\nhnote over Alice : thinking",
    "home": "sequence"
  },
  "keyword:rnote": {
    "summary": "Note drawn as a rectangle",
    "example": "Alice -> Bob : hi\nrnote over Alice : plain box",
    "home": "sequence"
  },
  "keyword:floating note": {
    "summary": "Note tied to no element",
    "example": "start\nfloating note left : free\n:step;\nstop",
    "home": "activity"
  },
  "keyword:over": {
    "summary": "Puts a note over one or more participants",
    "example": "Alice -> Bob : hi\nnote over Alice, Bob : both",
    "home": "sequence"
  },
  "keyword:of": {
    "summary": "Names the element a note sits beside",
    "example": "Alice -> Bob : hi\nnote left of Alice : hi",
    "home": "any"
  },
  "keyword:across": {
    "summary": "Spans a note over every participant",
    "example": "Alice -> Bob : hi\nnote across : all",
    "home": "sequence"
  },
  "keyword:left": {
    "summary": "Puts a note or text on the left",
    "example": "Alice -> Bob : hi\nnote left : here",
    "home": "any"
  },
  "keyword:right": {
    "summary": "Puts a note or text on the right",
    "example": "Alice -> Bob : hi\nnote right : here",
    "home": "any"
  },
  "keyword:top": {
    "summary": "Puts a note or text above",
    "example": "class A\nnote top of A : here",
    "home": "any"
  },
  "keyword:bottom": {
    "summary": "Puts a note or text below",
    "example": "class A\nnote bottom of A : here",
    "home": "any"
  },
  "keyword:center": {
    "summary": "Centres a header, footer or legend",
    "example": "center footer Page 1\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:together": {
    "summary": "Keeps elements side by side in layout",
    "example": "together {\n  class A\n  class B\n}",
    "home": "class"
  },
  "keyword:title": {
    "summary": "Title above the diagram",
    "example": "title Greeting\nAlice -> Bob : hi",
    "home": "any",
    "anywhere": true
  },
  "keyword:endtitle": {
    "summary": "Closes a multi-line title",
    "example": "title\n  Greeting\nendtitle\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:header": {
    "summary": "Text in the page header",
    "example": "header Draft\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:endheader": {
    "summary": "Closes a multi-line header",
    "example": "header\n  Draft\nendheader\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:footer": {
    "summary": "Text in the page footer",
    "example": "footer Page 1\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:endfooter": {
    "summary": "Closes a multi-line footer",
    "example": "footer\n  Page 1\nendfooter\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:legend": {
    "summary": "Legend box on the diagram",
    "example": "legend right\n  Key\nendlegend\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:endlegend": {
    "summary": "Closes a legend",
    "example": "legend\n  Key\nendlegend\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:caption": {
    "summary": "Text below the diagram",
    "example": "caption Figure 1\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:endcaption": {
    "summary": "Closes a multi-line caption",
    "example": "caption\n  Figure 1\nendcaption\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:mainframe": {
    "summary": "Frame around the whole diagram",
    "example": "mainframe Overview\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:newpage": {
    "summary": "Starts a new page",
    "example": "Alice -> Bob : one\nnewpage\nBob -> Alice : two",
    "home": "any"
  },
  "keyword:page": {
    "summary": "Splits the diagram into pages",
    "example": "page 2x1\nAlice -> Bob : one\nnewpage\nBob -> Alice : two",
    "home": "any"
  },
  "keyword:skinparam": {
    "summary": "Sets a skin parameter",
    "example": "skinparam backgroundColor LightYellow\nAlice -> Bob : hi",
    "home": "any",
    "anywhere": true
  },
  "keyword:skin": {
    "summary": "Loads a named skin",
    "example": "skin rose\nAlice -> Bob : hi",
    "home": "any",
    "anywhere": true
  },
  "keyword:hide": {
    "summary": "Hides a part of the diagram",
    "example": "hide footbox\nAlice -> Bob : hi",
    "home": "any",
    "anywhere": true
  },
  "keyword:show": {
    "summary": "Shows a part of the diagram again",
    "example": "hide footbox\nshow footbox\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:style": {
    "summary": "Picks a skin style",
    "example": "skinparam style strictuml\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:scale": {
    "summary": "Scales the whole diagram",
    "example": "scale 2\nAlice -> Bob : hi",
    "home": "any",
    "anywhere": true
  },
  "keyword:rotate": {
    "summary": "Turns the diagram a quarter",
    "example": "rotate\nAlice -> Bob : hi",
    "home": "any"
  },
  "keyword:allowmixing": {
    "summary": "Mixes element kinds in one diagram",
    "example": "allowmixing\nclass A\nactor B\nA --> B",
    "home": "any"
  },
  "keyword:allow_mixing": {
    "summary": "Mixes element kinds in one diagram",
    "example": "allow_mixing\nclass A\nactor B\nA --> B",
    "home": "any"
  },
  "keyword:left to right direction": {
    "summary": "Lays the diagram out left to right",
    "example": "left to right direction\nactor A\nA --> (use)",
    "home": "any"
  },
  "keyword:top to bottom direction": {
    "summary": "Lays the diagram out top to bottom",
    "example": "top to bottom direction\nclass A\nclass B\nA --> B",
    "home": "any"
  },
  "keyword:up": {
    "summary": "Points an arrow upward",
    "example": "class A\nclass B\nA -up-> B",
    "home": "any"
  },
  "keyword:down": {
    "summary": "Points an arrow downward",
    "example": "class A\nclass B\nA -down-> B",
    "home": "any"
  },
  "keyword:bold": {
    "summary": "Draws a bracketed arrow thick",
    "example": "class A\nclass B\nA -[bold]-> B",
    "home": "any"
  },
  "keyword:dashed": {
    "summary": "Draws a bracketed arrow dashed",
    "example": "class A\nclass B\nA -[dashed]-> B",
    "home": "any"
  },
  "keyword:dotted": {
    "summary": "Draws a bracketed arrow dotted",
    "example": "class A\nclass B\nA -[dotted]-> B",
    "home": "any"
  },
  "keyword:plain": {
    "summary": "Draws a bracketed arrow solid",
    "example": "class A\nclass B\nA -[plain]-> B",
    "home": "any"
  },
  "keyword:italic": {
    "summary": "Font style value",
    "example": "skinparam classFontStyle italic\nclass A",
    "home": "any"
  },
  "keyword:normal": {
    "summary": "Font style value",
    "example": "skinparam classFontStyle normal\nclass A",
    "home": "any"
  },
  "keyword:true": {
    "summary": "Boolean true in a condition",
    "example": "!$on = true\n!if $on\nAlice -> Bob : on\n!endif",
    "home": "any",
    "anywhere": true
  },
  "keyword:false": {
    "summary": "Boolean false in a condition",
    "example": "!$on = false\n!if $on\nAlice -> Bob : on\n!endif\nAlice -> Bob : always",
    "home": "any",
    "anywhere": true
  },
  "keyword:not": {
    "summary": "Negates a condition",
    "example": "!$on = false\n!if not $on\nAlice -> Bob : off\n!endif",
    "home": "any",
    "anywhere": true
  },
  "keyword:start": {
    "summary": "Begins the flow",
    "example": "start\n:step;\nstop",
    "home": "activity"
  },
  "keyword:stop": {
    "summary": "Ends the flow",
    "example": "start\n:step;\nstop",
    "home": "activity"
  },
  "keyword:if": {
    "summary": "Branches on a condition",
    "example": "start\nif (ok?) then (yes)\n  :go;\nendif\nstop",
    "home": "activity"
  },
  "keyword:then": {
    "summary": "Names the branch taken when true",
    "example": "start\nif (ok?) then (yes)\n  :go;\nendif\nstop",
    "home": "activity"
  },
  "keyword:elseif": {
    "summary": "Another condition after an if",
    "example": "if (a?) then (yes)\n  :a;\nelseif (b?) then (yes)\n  :b;\nendif",
    "home": "activity"
  },
  "keyword:endif": {
    "summary": "Closes an if",
    "example": "start\nif (ok?) then (yes)\n  :go;\nendif\nstop",
    "home": "activity"
  },
  "keyword:is": {
    "summary": "Names a branch value in a condition",
    "example": "start\nif (colour?) is (red) then\n  :stop;\nendif\nstop",
    "home": "activity"
  },
  "keyword:while": {
    "summary": "Repeats while a condition holds",
    "example": "start\nwhile (more?)\n  :work;\nendwhile\nstop",
    "home": "activity"
  },
  "keyword:endwhile": {
    "summary": "Closes a while",
    "example": "start\nwhile (more?)\n  :work;\nendwhile\nstop",
    "home": "activity"
  },
  "keyword:repeat": {
    "summary": "Starts a loop that runs at least once",
    "example": "start\nrepeat\n  :work;\nrepeat while (more?)\nstop",
    "home": "activity"
  },
  "keyword:repeatwhile": {
    "summary": "Ends a repeat loop on a condition",
    "example": "start\nrepeat\n  :work;\nrepeat while (more?)\nstop",
    "home": "activity"
  },
  "keyword:backward": {
    "summary": "Action run before each repeat",
    "example": "start\nrepeat\n  :work;\nbackward :rewind;\nrepeat while (more?)\nstop",
    "home": "activity"
  },
  "keyword:fork": {
    "summary": "Splits the flow into parallel branches",
    "example": "start\nfork\n  :a;\nfork again\n  :b;\nend fork",
    "home": "activity"
  },
  "keyword:again": {
    "summary": "Next branch of a fork",
    "example": "start\nfork\n  :a;\nfork again\n  :b;\nend fork",
    "home": "activity"
  },
  "keyword:endfork": {
    "summary": "Closes a fork, written end fork",
    "example": "start\nfork\n  :a;\nfork again\n  :b;\nend fork",
    "home": "activity"
  },
  "keyword:merge": {
    "summary": "Closes parallel branches as a merge",
    "example": "start\nfork\n  :a;\nfork again\n  :b;\nend merge",
    "home": "activity"
  },
  "keyword:endmerge": {
    "summary": "Closes parallel branches as a merge",
    "example": "start\nfork\n  :a;\nfork again\n  :b;\nendmerge",
    "home": "activity"
  },
  "keyword:split": {
    "summary": "Splits the flow into columns",
    "example": "start\nsplit\n  :a;\nsplit again\n  :b;\nend split",
    "home": "activity"
  },
  "keyword:switch": {
    "summary": "Branches on a value",
    "example": "start\nswitch (kind?)\ncase (a)\n  :A;\nendswitch\nstop",
    "home": "activity"
  },
  "keyword:case": {
    "summary": "One branch of a switch",
    "example": "start\nswitch (kind?)\ncase (a)\n  :A;\nendswitch\nstop",
    "home": "activity"
  },
  "keyword:endswitch": {
    "summary": "Closes a switch",
    "example": "start\nswitch (kind?)\ncase (a)\n  :A;\nendswitch\nstop",
    "home": "activity"
  },
  "keyword:detach": {
    "summary": "Ends a branch with no successor",
    "example": "start\n:step;\ndetach",
    "home": "activity"
  },
  "keyword:kill": {
    "summary": "Ends a branch with a cross",
    "example": "start\n:step;\nkill",
    "home": "activity"
  },
  "keyword:goto": {
    "summary": "Jumps to a label",
    "example": "start\ngoto done\n:skipped;\nlabel done\nstop",
    "home": "activity"
  },
  "keyword:label": {
    "summary": "Names a point to jump to",
    "example": "start\ngoto done\n:skipped;\nlabel done\nstop",
    "home": "activity"
  },
  "keyword:partition": {
    "summary": "Groups steps under a title",
    "example": "start\npartition Prep {\n  :a;\n}\nstop",
    "home": "activity"
  },
  "keyword:class": {
    "summary": "Declares a class",
    "example": "class Order",
    "home": "class"
  },
  "keyword:abstract": {
    "summary": "Declares an abstract class",
    "example": "abstract Shape",
    "home": "class"
  },
  "keyword:interface": {
    "summary": "Declares an interface",
    "example": "interface Drawable",
    "home": "class"
  },
  "keyword:enum": {
    "summary": "Declares an enumeration",
    "example": "enum Colour {\n  RED\n  BLUE\n}",
    "home": "class"
  },
  "keyword:annotation": {
    "summary": "Declares an annotation type",
