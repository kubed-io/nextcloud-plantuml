@startuml
' A class body holding a salt form: its braces are salt's, the class's own } closes it
class Form {
  {{salt
  {
    Name | "      "
    [Cancel] | [OK]
  }
  }}
  + submit() : void
}
legend
{{json
{"name": "Ada", "tags": ["a", 1, true, null]}
}}
end legend
